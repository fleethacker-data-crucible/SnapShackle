{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/fleethacker-data-crucible/fleet-action-baseline/contracts/action-manifest.schema.json",
  "title": "FleetAction action manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "app", "actions"],
  "properties": {
    "version": {
      "type": "integer",
      "const": 1
    },
    "app": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,62}$"
    },
    "actions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "app", "noun", "verb", "destructive", "parameters"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*){2}$"
          },
          "app": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,62}$"
          },
          "noun": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,62}$"
          },
          "verb": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,62}$"
          },
          "description": {
            "type": "string",
            "maxLength": 400
          },
          "destructive": {
            "type": "boolean"
          },
          "parameters": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["name", "type", "required"],
              "properties": {
                "name": {
                  "type": "string",
                  "pattern": "^[A-Za-z_][A-Za-z0-9_-]{0,63}$"
                },
                "type": {
                  "type": "string",
                  "enum": ["string", "number", "boolean"]
                },
                "required": {
                  "type": "boolean"
                },
                "description": {
                  "type": "string",
                  "maxLength": 400
                }
              }
            }
          }
        }
      }
    }
  }
}
